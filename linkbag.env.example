# LinkBag 运行时配置
#
# 默认位置：<数据目录>/linkbag.env（Docker 下是 /app/data/linkbag.env）。
# 修改后重启进程或容器生效。这里的 LINKBAG_* 值会覆盖容器环境变量，
# 其他前缀的键会被忽略。

# 控制台 / 接口的对外地址，显示在「设置 → 存储与地址」里。
# 反向代理带路径前缀时也要写全，例如 https://api.example.com/linkbag
LINKBAG_API_ORIGIN=https://api.example.com/linkbag

# 控制台挂在反向代理子路径时设置，例如 https://api.example.com/linkbag/ 对应 /linkbag。
#LINKBAG_BASE_PATH=/linkbag

# 备份站（归档）的对外地址。快照链接、插件附件链接都用它拼接。
LINKBAG_ARCHIVE_ORIGIN=https://archive.example.com

# 数据目录。Docker 部署时通常保持 /app/data，并确保宿主机目录挂载到这里。
LINKBAG_DATA_DIR=/app/data

# 监听地址和端口。改动端口后还要同步修改 Docker 端口映射或反向代理。
#LINKBAG_HOST=0.0.0.0
#LINKBAG_PORT=8787
#LINKBAG_ARCHIVE_HOST=0.0.0.0
#LINKBAG_ARCHIVE_PORT=8788
#LINKBAG_PUBLIC_HOST=example.com

# 插件目录，默认 <数据目录>/plugins。
#LINKBAG_PLUGINS_DIR=/app/data/plugins

# 额外允许调用 API 的来源，逗号分隔。
#LINKBAG_ALLOWED_ORIGINS=https://example.com
